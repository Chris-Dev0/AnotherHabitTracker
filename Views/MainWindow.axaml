<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnotherHabitTracker.ViewModels"
        x:Class="AnotherHabitTracker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="700"
        Height="550"
        Title="Habit Tracker">

    <StackPanel Margin="25" Spacing="14">
        <TextBlock Text="Habit Tracker" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Manage your daily habits" FontSize="14"/>
        <TextBlock Text="{Binding TodayLabel}" FontSize="13"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox Width="360" Watermark="Enter habit name"
                     Text="{Binding NewHabitName, Mode=TwoWay}"/>
            <Button Content="Add Habit" Command="{Binding AddHabitCommand}"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
        <TextBlock Text="My Habits" FontSize="18" FontWeight="Bold"/>

        <ListBox ItemsSource="{Binding HabitList}"
                 SelectedItem="{Binding SelectedHabit, Mode=TwoWay}"
                 Height="240">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HabitRow">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock Text="{Binding Name}" Width="280"/>
                        <TextBlock Text="{Binding TodayStatus}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Complete / Undo Selected"
                    Command="{Binding ToggleCompletionCommand}"/>
            <Button Content="Delete Selected Habit"
                    Command="{Binding DeleteHabitCommand}"/>
        </StackPanel>
        <TextBlock Text="Changes are saved automatically to a local JSON file."
                   FontSize="12"/>
    </StackPanel>
</Window>
